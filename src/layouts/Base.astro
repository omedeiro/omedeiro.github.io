---
export interface Props {
  title: string;
  description?: string;
  /** Widen the column past the usual 42rem. Only /habits needs this. */
  wide?: boolean;
}
const { title, description = "Owen Medeiros — electrical engineer working on superconducting electronics.", wide = false } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/maths", label: "Maths" },
  { href: "/habits", label: "Habits" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.png" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    />
    <style is:global>
      :root {
        --bg: #fdfdfc;
        --fg: #1c1c1a;
        --muted: #6b6b66;
        --accent: #8a4b2d;
        --border: #e5e3de;
        --code-bg: #f4f3f0;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #161615;
          --fg: #e8e6e1;
          --muted: #9a988f;
          --accent: #d99a72;
          --border: #2e2d2a;
          --code-bg: #232220;
        }
      }
      * { box-sizing: border-box; }
      html { font-size: 17px; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: Georgia, "Times New Roman", serif;
        line-height: 1.65;
      }
      .wrap {
        max-width: 42rem;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }
      .wrap.wide { max-width: 52rem; }
      header.site {
        margin-bottom: 3rem;
      }
      header.site .name {
        font-size: 1.05rem;
        font-weight: bold;
        letter-spacing: 0.01em;
        text-decoration: none;
        color: var(--fg);
      }
      nav.site {
        margin-top: 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.1rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 0.85rem;
      }
      nav.site a {
        color: var(--muted);
        text-decoration: none;
      }
      nav.site a:hover { color: var(--fg); }
      nav.site a.active { color: var(--fg); border-bottom: 1px solid var(--accent); }
      main h1 {
        font-size: 1.8rem;
        line-height: 1.25;
        margin: 0 0 1.25rem;
        font-weight: normal;
      }
      main h2 {
        font-size: 1.25rem;
        margin: 2.2rem 0 0.75rem;
        font-weight: bold;
      }
      main h3 {
        font-size: 1.05rem;
        margin: 1.6rem 0 0.5rem;
      }
      a { color: var(--accent); text-underline-offset: 2px; }
      a:hover { color: var(--fg); }
      img, video {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
      }
      figure { margin: 1.5rem 0; }
      figcaption, .caption {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 0.4rem;
      }
      hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }
      blockquote {
        margin: 1.5rem 0;
        padding-left: 1rem;
        border-left: 2px solid var(--border);
        color: var(--muted);
      }
      code {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.85em;
        background: var(--code-bg);
        padding: 0.1em 0.35em;
        border-radius: 3px;
      }
      pre {
        background: var(--code-bg);
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 0.8rem;
        line-height: 1.5;
      }
      pre code { background: none; padding: 0; font-size: inherit; }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.9rem;
        margin: 1.25rem 0;
      }
      th, td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.6rem;
        text-align: left;
      }
      th { background: var(--code-bg); }
      ul, ol { padding-left: 1.4rem; }
      li { margin: 0.25rem 0; }
      .pub-list li { margin: 0.8rem 0; }
      .pub-venue { color: var(--muted); font-style: italic; }
      /* Habits heatmap. Scoped to /habits, which is also the one page that
         loads client-side JS (for the tooltip). */
      .habits-chart { position: relative; margin: 2rem 0 1rem; }
      .habits-scroll { overflow-x: auto; overflow-y: visible; }
      .habits-chart svg { display: block; }
      .habits-cell { shape-rendering: crispEdges; }
      /* `is-pinned` marks the cell a tap has latched open — touch has no
         hover, so without it there is no sign of which cell is being read. */
      .habits-cell:hover,
      .habits-cell.is-pinned { stroke: var(--fg); stroke-width: 1px; }
      .habits-chart text {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      .habits-name { font-size: 11px; fill: var(--fg); }
      .habits-note, .habits-month { font-size: 9px; fill: var(--muted); }
      .habits-month { text-anchor: end; }
      .habits-tip {
        position: absolute;
        z-index: 5;
        transform: translate(-50%, -100%);
        pointer-events: none;
        background: var(--fg);
        color: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 0.72rem;
        line-height: 1.4;
        padding: 0.35rem 0.5rem;
        border-radius: 4px;
        white-space: nowrap;
        box-shadow: 0 1px 6px rgb(0 0 0 / 0.18);
      }
      .habits-tip b { display: block; font-weight: 600; }
      .habits-legend { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
      .habits-ramp {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        white-space: nowrap;
      }
      .habits-swatch {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 2px;
      }
      .habits-source { color: var(--muted); font-size: 0.85em; }
      .habits-empty { border-left: 2px solid var(--border); padding-left: 0.75rem; }
      /* A display equation too wide for the column scrolls in its own box
         rather than pushing the whole page sideways on a phone. */
      .katex-display { overflow-x: auto; overflow-y: hidden; padding: 2px 0; }
      /* Euler spiral viewer. Scoped to /maths/euler-spiral, the second page
         that loads client-side JS: a curve you can pan, zoom and trace needs a
         canvas. The --euler-* variables are read back out by the script, so the
         drawing follows the light and dark palettes without repeating them in
         JS. */
      .euler {
        --euler-curve: #8a4b2d;
        --euler-alt: #6b6b66;
        --euler-grid: rgba(28, 28, 26, 0.07);
        --euler-axis: rgba(28, 28, 26, 0.4);
        --euler-bg: #fbfaf8;
        margin: 1.75rem 0 1.5rem;
      }
      @media (prefers-color-scheme: dark) {
        .euler {
          --euler-curve: #d99a72;
          --euler-alt: #9a988f;
          --euler-grid: rgba(232, 230, 225, 0.07);
          --euler-axis: rgba(232, 230, 225, 0.38);
          --euler-bg: #121211;
        }
      }
      .euler-stage { position: relative; }
      .euler canvas {
        display: block;
        width: 100%;
        height: min(60vh, 31rem);
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--euler-bg);
        cursor: grab;
        /* The canvas owns every gesture on it, so a drag pans instead of
           scrolling the page. Expand gives it the whole screen. */
        touch-action: none;
      }
      .euler canvas.is-dragging { cursor: grabbing; }
      .euler canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .euler-zoom {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .euler-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 1.1rem;
        margin-top: 0.65rem;
      }
      .euler-controls,
      .euler figcaption {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      .euler-field {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .euler-field[hidden] { display: none; }
      .euler-field select,
      .euler button {
        font: inherit;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
      }
      .euler button { cursor: pointer; }
      .euler button:hover { border-color: var(--accent); color: var(--accent); }
      .euler-zoom button {
        width: 1.9rem;
        height: 1.9rem;
        padding: 0;
        font-size: 1rem;
        line-height: 1;
        background: var(--bg);
      }
      .euler-buttons { gap: 0.4rem; }
      .euler-field input[type="range"] {
        width: 8.5rem;
        accent-color: var(--accent);
      }
      .euler-field output {
        min-width: 3.2rem;
        font-variant-numeric: tabular-nums;
        color: var(--fg);
      }
      .euler-readout { font-variant-numeric: tabular-nums; }
      .euler-legend { display: inline-flex; flex-wrap: wrap; gap: 0.9rem; margin-left: 0.9rem; }
      .euler-key { display: inline-flex; align-items: center; gap: 0.35rem; }
      .euler-key i {
        width: 11px;
        height: 3px;
        border-radius: 2px;
      }
      .euler.is-expanded {
        position: fixed;
        inset: 0;
        z-index: 60;
        margin: 0;
        padding: 0.75rem;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .euler.is-expanded .euler-stage { flex: 1 1 auto; min-height: 0; }
      .euler.is-expanded canvas { height: 100%; }
      .euler.is-expanded figcaption { margin: 0; }
      body.euler-locked { overflow: hidden; }
      footer.site {
        margin-top: 4rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 0.8rem;
        color: var(--muted);
      }
      footer.site a { color: var(--muted); }
      footer.site a:hover { color: var(--fg); }
    </style>
  </head>
  <body>
    <div class={wide ? "wrap wide" : "wrap"}>
      <header class="site">
        <a class="name" href="/">Owen Medeiros</a>
        <nav class="site">
          {nav.map((item) => (
            <a
              href={item.href}
              class={path === item.href || (item.href !== "/" && path.startsWith(item.href)) ? "active" : ""}
            >{item.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site">
        <a href="mailto:medeirosowen@gmail.com">Email</a> ·
        <a href="https://github.com/omedeiro">GitHub</a> ·
        <a href="https://linkedin.com/in/owenmedeiros">LinkedIn</a>
      </footer>
    </div>
  </body>
</html>
